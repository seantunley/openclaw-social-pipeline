# --- LLM provider ---
# Which provider drives the bulk-text stages (SEO/GEO generate, humanize).
# - "anthropic"   (default) — uses Claude via ANTHROPIC_API_KEY below
# - "openai-codex"          — rides your ChatGPT Plus/Pro/Business subscription
#                             via OAuth tokens written by OpenAI's Codex CLI
LLM_PROVIDER=anthropic

# --- Anthropic ---
# Required even when LLM_PROVIDER=openai-codex, because the bot's research
# stage uses Claude's server-side `web_search` tool — the Codex backend has
# no equivalent, and citation-readiness is the SEO/GEO load-bearer.
ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI Codex (only when LLM_PROVIDER=openai-codex) ---
# Prerequisites:
#   1. Install Codex CLI:  npm i -g @openai/codex
#   2. Authenticate:       codex login
# That writes ~/.codex/auth.json which the bot reads + refreshes in place.
# Override the model if you want gpt-5.5 / gpt-5.4-pro / gpt-5.4-mini etc.
LLM_OPENAI_CODEX_MODEL=gpt-5.4
# Optional: point at a non-default credentials file.
# CODEX_AUTH_PATH=
#
# Caveats:
#   - Subscription rate limits (much lower than API limits)
#   - chatgpt.com/backend-api/codex is undocumented; can change without notice
#   - OpenAI's stance on third-party use of these tokens is "supportive but
#     not formal" — known but unblessed. Use at your own risk.

# --- Image / video generation ---
# Primary: fal.ai (editorial-quality photo, video). Used first.
FAL_API_KEY=...
# Fallback: OpenAI (gpt-image-1). Used when fal returns 401/5xx/empty.
# Set this to a regular OpenAI API key (NOT a Codex OAuth token — those are
# scoped to chat completions, not images).
OPENAI_API_KEY=...
# Optional: image / video provider override (default: fal)
# IMAGE_PROVIDER=fal
# VIDEO_PROVIDER=fal

# --- Postiz publishing ---
# Mode: "api" (default) or "cli" (shells out to npx postiz)
POSTIZ_MODE=api
POSTIZ_API_URL=http://localhost:5000
POSTIZ_API_KEY=...
# Optional: skip auto-discovery and pin the integration that the bot publishes to
# POSTIZ_DEFAULT_INTEGRATION_ID=

# --- Telegram bot ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Numeric user id of the operator (from @userinfobot). Bot ignores everyone else.
TELEGRAM_AUTHORIZED_USER_ID=
# Default platform for /topic runs when no platform is specified
BOT_DEFAULT_PLATFORM=linkedin

# --- Dashboard API ---
API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3001
# DB_PATH=./data/social-pipeline.db
