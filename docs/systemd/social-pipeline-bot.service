[Unit]
Description=Social Pipeline Telegram Bot
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/social-pipeline/engine
ExecStart=/usr/bin/node --env-file=.env %h/social-pipeline/engine/dist/src/bot/index.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
