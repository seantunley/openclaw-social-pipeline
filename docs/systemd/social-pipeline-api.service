[Unit]
Description=Social Pipeline Dashboard API
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/social-pipeline/engine
ExecStart=/usr/bin/node --env-file=.env %h/social-pipeline/engine/dist/dashboard-api/server.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
